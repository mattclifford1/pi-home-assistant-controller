# MQTT broker connection (see README section 1 to get these).
MQTT_HOST=192.168.1.221
MQTT_PORT=1883
MQTT_USER=pi_sensehat
MQTT_PASS=pi3

# --- tuning knobs (optional; restart service after changing) ---
# How often sensor readings are published, seconds.
PUBLISH_INTERVAL=30
# Subtract this from the temperature reading (the Pi's CPU warms the sensor;
# 5-8 is typical once the Pi has been running a while). 0 = no correction.
TEMP_OFFSET=17

# --- Command topics (must match ha-automation.yaml) ---
LIGHTS_TOPIC=sensehat/bedroom/lights/set
BLINDS_TOPIC=sensehat/bedroom/blinds/set

# Minimum gap between repeated commands, seconds. Spinning the knob fires one
# event per detent; the blinds only need telling once, so extras are dropped.
ACTION_DEBOUNCE=0.4

# --- USB volume knob ---
# volume up = blinds close, volume down = blinds open, mute press = lights toggle
ENABLE_KNOB=true
# Leave blank to auto-detect by name; or pin it, e.g.
# KNOB_DEVICE=/dev/input/by-id/usb-ZhenHuiDesignTechnology_USB-AUDIO_SYSTEM_20180105-event-if00
KNOB_DEVICE=
# Substring matched against input device names when auto-detecting.
KNOB_NAME_MATCH=USB-AUDIO

# --- Sense HAT ---
# Optional: the service runs fine without it and picks it up automatically if
# refitted. Set false to skip looking for it entirely.
ENABLE_SENSEHAT=true

# --- Auto-orientation (Sense HAT joystick only) ---
# true = follow the accelerometer; false = always use DEFAULT_ROTATION.
AUTO_ORIENT=true
# Used when the Pi lies flat (orientation can't be sensed). 0/90/180/270.
DEFAULT_ROTATION=180
# Calibration: added to the detected rotation if directions come out turned
# from what you expect. Multiple of 90 (0/90/180/270).
ROTATION_OFFSET=0
