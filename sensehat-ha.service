[Unit]
Description=Sense HAT to Home Assistant bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=matt
WorkingDirectory=/home/matt/sensehat-ha
EnvironmentFile=/home/matt/sensehat-ha/config.env
ExecStart=/usr/bin/python3 /home/matt/sensehat-ha/sensehat_ha.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
